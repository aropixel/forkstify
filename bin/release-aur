#!/usr/bin/env bash
# Refresh the Arch package from a published release: the version, the real
# digest, the .SRCINFO, and a build to prove it. Optionally push it to the
# AUR, which is one git repository per package.
#
#   bin/release-aur            the version manifest.json carries
#   bin/release-aur 0.2.0
#   bin/release-aur 0.2.0 --publish   also push to the AUR
#
# Everything heavy happens in a temporary directory: makepkg leaves 100+ MB
# of src/, pkg/ and archives next to the PKGBUILD, and this repository is
# the Omarchy plugin — every user clones it (lesson of 21/09/2026).
set -euo pipefail
cd "$(dirname "$0")/.."
PKGDIR="packaging/aur/forkstify-bin"
REPO="aropixel/forkstify"

say()  { printf '%s\n' "$*"; }
die()  { printf '%s\n' "$*" >&2; exit 1; }

[ -f "$PKGDIR/PKGBUILD" ] || die "no $PKGDIR/PKGBUILD"
version="${1:-$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' manifest.json | head -1)}"
[ -n "$version" ] || die "no version given and none in manifest.json"
publish=false
[ "${2:-}" = "--publish" ] && publish=true

name="forkstify-$version-x86_64-linux.tar.gz"
base="https://github.com/$REPO/releases/download/v$version"
tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT

# --- the published archive, checked, not taken on faith ---------------------
say "fetching $name…"
curl -fsSL "$base/$name" -o "$tmp/$name" || die "no such release asset — has the workflow finished?"
curl -fsSL "$base/SHA256SUMS" -o "$tmp/SHA256SUMS" || die "no SHA256SUMS on the release"
( cd "$tmp" && grep -F " $name" SHA256SUMS | sha256sum -c --status - ) \
  || die "the archive does not match the published SHA256SUMS — stop here"
sum=$(awk -v n="$name" '$2 == n {print $1}' "$tmp/SHA256SUMS")
[ -n "$sum" ] || die "no digest for $name in SHA256SUMS"
say "archive verified: $sum"

# --- the PKGBUILD -----------------------------------------------------------
had=$(sed -n 's/^pkgver=\(.*\)/\1/p' "$PKGDIR/PKGBUILD")
if [ "$had" = "$version" ]; then
  rel=$(sed -n 's/^pkgrel=\(.*\)/\1/p' "$PKGDIR/PKGBUILD")
  rel=$((rel + 1))
  say "same version: pkgrel $((rel - 1)) → $rel"
else
  rel=1
  say "pkgver $had → $version, pkgrel 1"
fi
sed -i "s/^pkgver=.*/pkgver=$version/" "$PKGDIR/PKGBUILD"
sed -i "s/^pkgrel=.*/pkgrel=$rel/" "$PKGDIR/PKGBUILD"
sed -i "s/^sha256sums=(.*)/sha256sums=('$sum')/" "$PKGDIR/PKGBUILD"
( cd "$PKGDIR" && makepkg --printsrcinfo > .SRCINFO )

# --- prove it builds, away from the repository ------------------------------
say "building the package to prove it…"
cp "$PKGDIR/PKGBUILD" "$tmp/"
( cd "$tmp" && makepkg -f --noconfirm --nodeps >/dev/null 2>&1 ) || die "makepkg failed — the PKGBUILD is wrong"
built=$(ls "$tmp"/*.pkg.tar.zst 2>/dev/null | wc -l)
[ "$built" = "1" ] || die "expected one package, got $built — check options=('!strip' '!debug')"
say "built: $(basename "$(ls "$tmp"/*.pkg.tar.zst)")"

git --no-pager diff --stat -- "$PKGDIR"
say "ready. Commit it, then publish with: bin/release-aur $version --publish"

# --- the AUR ----------------------------------------------------------------
if $publish; then
  say "pushing to the AUR…"
  git clone -q "ssh://aur@aur.archlinux.org/forkstify-bin.git" "$tmp/aur" \
    || die "cannot reach the AUR — an account with an SSH key is needed, and registration may be closed"
  cp "$PKGDIR/PKGBUILD" "$PKGDIR/.SRCINFO" "$tmp/aur/"
  ( cd "$tmp/aur" && git add -A && git commit -qm "forkstify-bin $version-$rel" && git push -q )
  say "published: https://aur.archlinux.org/packages/forkstify-bin"
fi
