#!/usr/bin/env bash
# Build forkstify in its container (the machine's PHP/Rust is not for
# projects: everything is dockerized). The image is built on first call;
# the cargo registry lives in the forkstify-cargo volume.
#   bin/build          → cargo build --release
#   bin/build <args…>  → cargo <args…>   (e.g. bin/build test --release)
set -euo pipefail
cd "$(dirname "$0")/.."
docker image inspect forkstify-build >/dev/null 2>&1 || docker build -q -t forkstify-build .
if [ $# -eq 0 ]; then set -- build --release; fi
exec docker run --rm -t -v "$PWD":/app -w /app -v forkstify-cargo:/usr/local/cargo/registry forkstify-build cargo "$@"
