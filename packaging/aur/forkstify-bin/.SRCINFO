pkgbase = forkstify-bin
	pkgdesc = Music player that plays by branches, wired to Spotify, over a catalog you can fork
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/aropixel/forkstify
	arch = x86_64
	license = MIT
	depends = alsa-lib
	depends = gcc-libs
	depends = glibc
	depends = git
	optdepends = github-cli: fork the reference catalog from the setup
	optdepends = xdg-utils: open an artist in the browser (ag)
	provides = forkstify=0.1.0
	conflicts = forkstify
	source = forkstify-0.1.0.tar.gz::https://github.com/aropixel/forkstify/releases/download/v0.1.0/forkstify-0.1.0-x86_64-linux.tar.gz
	sha256sums = SKIP

pkgname = forkstify-bin
